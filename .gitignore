# Virtual environments
.venv/
venv/
env/

# Python caches / build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Vendored third-party checkouts (cloned separately, each has its own .git)
pox/
mininet/

# ...but OUR firewall app lives inside the POX tree, because pox/boot.py adds
# pox/ext to sys.path itself (the module must be named `firewall`, not
# `pox.ext.firewall`).  It is a deliverable, so it is tracked even though the
# directory containing it is ignored.
!pox/ext/firewall.py

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Report intermediates (captured transcripts; regenerate with report/capture.sh)
report/.logs/
report/figs/*.slice.ansi

# Runtime logs
logs/

# LaTeX build intermediates
report/report.aux
report/report.log
report/report.out
report/*.synctex.gz
report/report.fls
report/report.fdb_latexmk